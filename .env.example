# Discord bot token (Developer Portal > Bot > Reset Token). NEVER commit this or share it.
DISCORD_TOKEN=

# Right-click your server icon in Discord (Developer Mode ON) > Copy Server ID
GUILD_ID=

# Passcode to open the Control Room in the browser (change this)
DASHBOARD_PASSCODE=changeme123

# Port the app runs on (Railway/Render set this automatically, leave as is)
PORT=3000
